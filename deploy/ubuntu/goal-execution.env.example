# systemd EnvironmentFile — GOAL_EXECUTION_* only (reviewer list lives in skstudio)
# Postgres only（与仓库根 .env.example 对齐）
HERMES_SHARED_ROOT=/var/lib/hermes

DATABASE_URL=postgresql+psycopg://skstudio:替换密码@127.0.0.1:5432/goal_execution
REQUIRE_POSTGRES=1

# 须与 skstudio JWT_SECRET 同值
GOAL_EXECUTION_JWT_SECRET=替换为与-skstudio-JWT_SECRET-同值
GOAL_EXECUTION_JWT_ALGORITHM=HS256

# skstudio BFF / internal Bearer（须与 skstudio GOAL_EXECUTION_SERVICE_TOKEN 同值）
GOAL_EXECUTION_SERVICE_TOKEN=替换为强随机-token-与-skstudio-同值

# skstudio internal base（可选；历史回调用）
SKSTUDIO_INTERNAL_URL=http://127.0.0.1:8000

# GateItem 证据层：归属校验（须与 knowledge-base 同值；未配置则 submit/sign → 503）
KBASE_BASE_URL=http://127.0.0.1:8091
KBASE_SERVICE_TOKEN=替换为与-knowledge-base-KNOWLEDGE_BASE_SERVICE_TOKEN-同值
# KBASE_ASSERT_TIMEOUT_SECONDS=2.5

HOST=127.0.0.1
PORT=8092
